{
  "expo": {
    "name": "catatankeuangan",
    "slug": "catatankeuangan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/wallet.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.catatankeuangan.app",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.catatankeuangan",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/wallet.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/wallet.png"
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/wallet.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
